@{
    ViewData["Title"] = "Sales Records";
}

<h2>@ViewData["Title"]</h2>

<div class="col-md-4">
    <form asp-action="SimpleSearch">
        <div class="form-group">
            <label for="minDate">Min Date</label>
            <input type="date" name="minDate" class="form-control" />
        </div>
        <div class="form-group">
            <label for="maxDate">Max Date</label>
            <input type="date" name="maxDate" class="form-control" />
        </div>
        <div class="form-group mt-3">
            <input type="submit" value="Simple Search" class="btn btn-primary" />
        </div>
    </form>
</div>

<div class="col-md-4">
    <form asp-action="GroupingSearch">
        <div class="form-group">
            <label for="minDate">Min Date</label>
            <input type="date" name="minDate" class="form-control" />
        </div>
        <div class="form-group">
            <label for="maxDate">Max Date</label>
            <input type="date" name="maxDate" class="form-control" />
        </div>
        <div class="form-group mt-3">
            <input type="submit" value="Grouping Search" class="btn btn-primary" />
        </div>
    </form>
</div>